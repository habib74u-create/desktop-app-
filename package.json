{
  "name": "jarvis-ai-assistant",
  "version": "1.3.11",
  "description": "Jarvis - AI Assistant for Mac and Windows with voice dictation and AI capabilities",
  "main": "dist/main.js",
  "author": "Jarvis Team",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "ai",
    "assistant",
    "dictation",
    "voice",
    "mac",
    "windows"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEBPACK,ELECTRON -c cyan,magenta \"cross-env NODE_ENV=development webpack --watch\" \"wait-on dist/main.js && cross-env NODE_ENV=development electron .\"",
    "start": "electron .",
    "build": "npm run build:native && npx webpack",
    "build:web": "npx webpack",
    "build:tsc": "tsc --noEmit",
    "build:native": "node-gyp rebuild || echo \"node-gyp rebuild skipped (macOS-only native modules)\"",
    "server": "tsx src/server/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:regression": "jest --testPathPattern=regression",
    "test:performance": "jest --testPathPattern=performance",
    "test:robustness": "node scripts/test-robustness.js",
    "test:launch": "node scripts/launch-readiness.js",
    "build:mac": "npm run build && electron-builder --mac --dir",
    "build:dmg": "npm run build && electron-builder --mac --x64 --arm64",
    "build:dmg:custom": "npm run build:mac && chmod +x ./scripts/create-dmg.sh && ./scripts/create-dmg.sh both",
    "build:dmg:x64": "npm run build:mac && chmod +x ./scripts/create-dmg.sh && ./scripts/create-dmg.sh x64",
    "build:dmg:arm64": "npm run build:mac && chmod +x ./scripts/create-dmg.sh && ./scripts/create-dmg.sh arm64",
    "build:signed": "chmod +x ./scripts/notarization/build-sign-notarize.sh && ./scripts/notarization/build-sign-notarize.sh both",
    "build:signed:x64": "chmod +x ./scripts/notarization/build-sign-notarize.sh && ./scripts/notarization/build-sign-notarize.sh x64",
    "build:signed:arm64": "chmod +x ./scripts/notarization/build-sign-notarize.sh && ./scripts/notarization/build-sign-notarize.sh arm64",
    "notarize": "chmod +x ./scripts/notarization/quick-notarize.sh && ./scripts/notarization/quick-notarize.sh",
    "build:win": "npm run build:web && electron-builder --win nsis --x64 --config electron-builder.yml",
    "build:linux": "npm run build:web && electron-builder --linux --x64 --config electron-builder.yml",
    "dist": "npm run build:dmg",
    "dist:win": "npm run build:win",
    "dist:mac": "npm run build:dmg",
    "dist:linux": "npm run build:linux",
    "postinstall": "electron-rebuild -f -w uiohook-napi,whisper-node-addon || echo \"electron-rebuild skipped\""
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.1",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "create-dmg": "^7.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "node-loader": "^2.0.0",
    "postcss": "^8.5.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "wait-on": "^8.0.3",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.5.1",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "bufferutil": "^4.0.8",
    "canvas-confetti": "^1.9.3",
    "dotenv": "^16.5.0",
    "fastify": "^4.29.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.3",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "node-addon-api": "^8.4.0",
    "node-fetch": "^3.3.2",
    "openai": "^5.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sherpa-onnx-node": "^1.12.23",
    "uiohook-napi": "^1.5.2",
    "utf-8-validate": "^6.0.3",
    "webpack": "^5.89.0",
    "whisper-node-addon": "^1.0.2",
    "ws": "^8.18.3",
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.12.24",
    "sherpa-onnx-darwin-x64": "1.12.24",
    "sherpa-onnx-win-x64": "1.12.24",
    "sherpa-onnx-linux-x64": "1.12.24"
  },
  "build": {
    "appId": "com.jarvis.ai-assistant",
    "productName": "Jarvis",
    "copyright": "Copyright © 2025 Jarvis Team",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/node_modules/*/{test,__tests__,tests,example,examples,docs}/**",
      "!**/node_modules/.bin/**",
      "!**/.github/**",
      "!**/scripts/**",
      "!**/src/**"
    ],
    "extraResources": [
      { "from": "assets/jarvis-logo-dark.png", "to": "jarvis-logo-dark.png" },
      { "from": "assets/jarvis-logo-light.png", "to": "jarvis-logo-light.png" },
      { "from": "assets/jarvis-logo.png", "to": "jarvis-logo.png" },
      { "from": "assets/jarvis-menubar-template.png", "to": "jarvis-menubar-template.png" },
      { "from": "assets/icon.png", "to": "icon.png" },
      { "from": "assets/ffmpeg/_stage", "to": "ffmpeg" },
      { "from": "assets/sounds", "to": "sounds", "filter": ["**/*.mp3", "**/*.wav"] }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-arm64/**",
      "node_modules/sherpa-onnx-darwin-x64/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "node_modules/sherpa-onnx-linux-x64/**",
      "node_modules/uiohook-napi/**",
      "node_modules/whisper-node-addon/**",
      "node_modules/better-sqlite3/**"
    ],
    "afterSign": "scripts/after-sign.js",
    "afterPack": "scripts/after-pack.js",
    "beforePack": "scripts/before-pack.js",
    "protocols": [
      { "name": "Jarvis Protocol", "schemes": ["jarvis"] }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "certificates/entitlements.mac.plist",
      "entitlementsInherit": "certificates/entitlements.mac.inherit.plist",
      "type": "distribution",
      "bundleVersion": "0.1.0",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis needs microphone access for voice dictation and AI assistance.",
        "NSCameraUsageDescription": "Jarvis uses the camera only when you start a video analysis.",
        "NSAccessibilityUsageDescription": "Jarvis needs Accessibility to detect the global push-to-talk key and paste transcriptions.",
        "NSInputMonitoringUsageDescription": "Jarvis monitors the push-to-talk key system-wide while running.",
        "NSScreenCaptureUsageDescription": "Jarvis captures the screen only when you request an analysis overlay.",
        "NSAppleEventsUsageDescription": "Jarvis uses AppleEvents to paste transcriptions into the frontmost application."
      },
      "extraResources": [
        { "from": "build/Release/universal_key_monitor.node", "to": "universal_key_monitor.node" },
        { "from": "build/Release/fn_key_monitor.node", "to": "fn_key_monitor.node" },
        { "from": "build/Release/audio_capture.node", "to": "audio_capture.node" },
        { "from": "build/Release/typing_monitor.node", "to": "typing_monitor.node" },
        { "from": "build/Release/nsevent_monitor.node", "to": "nsevent_monitor.node" }
      ]
    },
    "dmg": {
      "background": "dmg-assets/background.png",
      "icon": "assets/icon.icns",
      "iconSize": 80,
      "format": "UDZO",
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "window": { "width": 600, "height": 400 },
      "contents": [
        { "x": 150, "y": 200, "type": "file" },
        { "x": 450, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "publisherName": "Jarvis Team",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "jarvis-ai-assistant",
      "releaseType": "release"
    }
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
